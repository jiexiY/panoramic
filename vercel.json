{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/welcome", "destination": "/", "permanent": false },
    { "source": "/app/supervision", "destination": "/app/spatial", "permanent": false },
    { "source": "/app/history", "destination": "/app/session/history", "permanent": false }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/spatial", "destination": "/index.html" },
    { "source": "/app/session", "destination": "/index.html" },
    { "source": "/app/session/history", "destination": "/index.html" },
    { "source": "/app/spatial/:suite", "destination": "/index.html" },
    { "source": "/app/dashboard/:suite", "destination": "/index.html" }
  ],
  "functions": { "api/gemini.ts": { "maxDuration": 45 }, "api/elevenlabs.ts": { "maxDuration": 30 } },
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
    { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' data: https://kcyfplbnavcdruogkvbr.supabase.co wss://kcyfplbnavcdruogkvbr.supabase.co; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'" }
  ] }]
}
