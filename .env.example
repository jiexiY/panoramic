VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only: never use the VITE_ prefix for these values.
# Leave blank until the owner verifies this project is on Google's Free Tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FREE_TIER_CONFIRMED=false
# A separate private demo access code, at least 16 characters; NOT the API key.
GEMINI_DEMO_ACCESS_CODE=

# Server-only station voice. Never put these values in VITE_ variables.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Separate private access code, at least 16 characters. This is NOT the API key.
ELEVENLABS_ACCESS_CODE=
# Owner must approve provider usage/credits and set an account quota before enabling.
ELEVENLABS_USAGE_CONFIRMED=false
# Local development only: use the existing production voice server without copying its API key.
# The supervisor still enters the same private voice access code and confirms each voice opt-in.
ELEVENLABS_USE_PRODUCTION_VOICE=false
